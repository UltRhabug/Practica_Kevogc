---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Sobre mí";

const identity = {
  firstName: "Alberto",
  nickname: "Beto",
  school: "CETI Colomos, Guadalajara",
  occupation: "Estudiante de Tecnología en Desarrollo de Software",
  hobbies: ["electrónica y sistemas embebidos", "karate", "trastear con IoT"],
};

const skills = [
  "ESP32 / RP2040", "Arduino", "React", "Node.js", "FastAPI",
  "ASP.NET Core", "Firebase", "MongoDB", "Python", "Rust (aprendiendo)"
];

const buildingHybridProfile = true;
const jobHunting = true;
const goal = 3;
---

<BaseLayout pageTitle={pageTitle}>
  <p class="kicker">perfil híbrido — hardware + software</p>

  <p>
    Soy {identity.firstName} ({identity.nickname}), {identity.occupation} en {identity.school},
    en mis últimos semestres. Combino electrónica embebida con desarrollo web full-stack:
    de un microcontrolador ESP32 a una API en producción.
  </p>

  <p>
    Uno de mis proyectos que más disfruté: diseñar controles electrónicos de juez para
    competencias de karate. También estoy construyendo <strong>AxDeport</strong>, una
    plataforma para administrar eventos de deportes de combate, junto con mi socio Leonardo.
  </p>

  <h2>Fuera del código</h2>
  <ul>
    <li>Me llamo {identity.firstName}, aunque casi todos me dicen {identity.nickname}.</li>
    <li>Estudio y trabajo desde Guadalajara, México.</li>
    {
      identity.hobbies.length >= 2 && (
        <li>
          Entre mis intereses: {identity.hobbies[0]} y {identity.hobbies[1]}.
        </li>
      )
    }
  </ul>

  <h2>Con lo que trabajo</h2>
  <ul class="skill-list">
    {skills.map((skill) => <li class="skill">{skill}</li>)}
  </ul>

  {buildingHybridProfile && <p>Estoy construyendo activamente ese perfil híbrido hardware/software.</p>}

  {jobHunting && <p>Ando buscando entrar a la industria electrónica de Guadalajara/Zapopan.</p>}

  {
    goal === 3
      ? <p>Mi meta: publicar un proyecto nuevo en la bitácora al menos cada 3 semanas.</p>
      : <p>Sin meta de publicación fija por ahora.</p>
  }
</BaseLayout>
